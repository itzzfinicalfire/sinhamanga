# ──────────────────────────────────────────────────────────────
# SinhaManga configuration
# Copy this file to ".env" and fill in your key.
# ──────────────────────────────────────────────────────────────

# Your DeepSeek API key — get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# Optional: which DeepSeek model to use (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Optional: port for the API + production server (default: 3001)
# PORT=3001
